# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:0.12.12 AS uv-bin

FROM rust:1.96.0-slim-bookworm AS native-egress-build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked --package codex-lb-egress-worker --bin codex-lb-native-egress \
    && cp target/release/codex-lb-native-egress /tmp/codex-lb-native-egress

# Keep the qualified OS and dashboard; apply the scoped dependency locks.
FROM ghcr.io/soju06/codex-lb:1.25.0-beta.9@sha256:514b4d7fc0c2a7dea5ced20f97eceb43910b1276738a87fa56484f3f4dfde7f7
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libpcre2-8-0=10.46-1~deb13u3 \
       libssl3t64=3.5.7-1~deb13u3 \
       openssl=3.5.7-1~deb13u3 \
       openssl-provider-legacy=3.5.7-1~deb13u3 \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=bind,from=uv-bin,source=/uv,target=/uv,ro \
    --mount=type=bind,source=pyproject.toml,target=/app/pyproject.toml,ro \
    --mount=type=bind,source=uv.lock,target=/app/uv.lock,ro \
    UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never UV_NO_CACHE=1 \
    /uv sync --frozen --no-dev --no-install-project --extra metrics --extra tracing
USER app
COPY --from=native-egress-build --chmod=755 /tmp/codex-lb-native-egress /usr/local/bin/codex-lb-native-egress
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/tacodong/codex-lb" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.base.revision="69f128afcbc616d9f8e924ca6583f7031d75cf82"
COPY --chown=app:app app/core/clients/native_egress.py app/core/clients/proxy_websocket.py /app/app/core/clients/
COPY --chown=app:app app/core/openai/requests.py /app/app/core/openai/requests.py
COPY --chown=app:app app/modules/proxy/api.py /app/app/modules/proxy/api.py
COPY --chown=app:app app/main.py /app/app/main.py
COPY --chown=app:app app/core/auth/dependencies.py /app/app/core/auth/dependencies.py
COPY --chown=app:app app/db/sqlite_utils.py /app/app/db/sqlite_utils.py
